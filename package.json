{
  "name": "povod",
  "version": "0.0.0",
  "private": true,
  "workspaces": ["apps/web", "apps/api"],
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "26.13.0",
    "npm": "11.20.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=@povod/web",
    "dev:api": "npm run dev --workspace=@povod/api",
    "start:web": "npm run start --workspace=@povod/web",
    "start:api": "npm run start --workspace=@povod/api",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "test": "vitest run scripts/artifact",
    "artifact:create": "node scripts/artifact/create.mjs",
    "artifact:verify": "node scripts/artifact/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
