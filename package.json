{
  "name": "povod",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/api-client"
  ],
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "26.13.0",
    "npm": "11.20.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=@povod/web",
    "dev:api": "npm run dev --workspace=@povod/api",
    "start:web": "npm run start --workspace=@povod/web",
    "start:api": "npm run start --workspace=@povod/api",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "test": "vitest run scripts/artifact apps/web/tests",
    "artifact:create": "node scripts/artifact/create.mjs",
    "artifact:verify": "node scripts/artifact/verify.mjs",
    "db:migrate:dev": "node scripts/database.mjs migrate dev",
    "db:migrate:test": "node scripts/database.mjs migrate test",
    "db:seed:dev": "node scripts/database.mjs seed dev",
    "db:seed:test": "node scripts/database.mjs seed test",
    "test:database": "node scripts/database.mjs test test",
    "dev:api:database": "node scripts/api-dev.mjs",
    "api:openapi": "node scripts/export-openapi.mjs",
    "api:generate": "orval --config orval.config.ts",
    "test:web": "vitest run --config apps/web/vitest.config.mts",
    "format:web": "prettier --check \"apps/web/src/**/*.{ts,tsx,css,json}\" \"packages/api-client/src/*.ts\""
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "orval": "8.48.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
