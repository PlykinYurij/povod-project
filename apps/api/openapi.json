  "info": {
    "title": "Повод API",
    "description": "",
    "version": "0.3.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-povod-session"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "owner@example.test",
            "description": "Trimmed, case-insensitive; dots and plus tags preserved"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "writeOnly": true,
            "format": "password",
            "pattern": "^(?=.*[A-Z])(?=.*[0-9])(?=.*[^A-Za-z0-9 ])[\\x20-\\x7E]{8,128}(?![\\s\\S])",
            "description": "Printable ASCII only: A-Z/a-z, 0-9, punctuation and space. Requires an uppercase letter, digit and special character; space is not a special character. No trimming."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RegisteredUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "id",
          "email"
        ]
      },
      "RegisterResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/RegisteredUserDto"
          }
        },
        "required": [
          "user"
        ]
      },
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "code"
        ]
      },
      "ErrorDetailsDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetailsDto"
          }
        },
        "required": [
          "error"
        ]
      },
      "CsrfResponseDto": {
        "type": "object",
        "properties": {
          "csrfToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "csrfToken",
          "expiresAt"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "owner@example.test",
            "description": "Trimmed, case-insensitive; dots and plus tags preserved"
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RequestPasswordResetDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "owner@example.test",
            "description": "Trimmed, case-insensitive; dots and plus tags preserved"
          }
        },
        "required": [
          "email"
        ]
      },
      "PasswordResetAcceptedDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Если аккаунт существует, письмо с кодом будет доступно в почте"
          }
        },
        "required": [
          "message"
        ]
      },
      "ConfirmPasswordResetDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "owner@example.test",
            "description": "Trimmed, case-insensitive; dots and plus tags preserved"
          },
          "code": {
            "type": "string",
            "writeOnly": true,
            "pattern": "^[0-9]{6}(?![\\s\\S])",
            "minLength": 6,
            "maxLength": 6
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "writeOnly": true,
            "format": "password",
            "pattern": "^(?=.*[A-Z])(?=.*[0-9])(?=.*[^A-Za-z0-9 ])[\\x20-\\x7E]{8,128}(?![\\s\\S])",
            "description": "Printable ASCII only: A-Z/a-z, 0-9, punctuation and space. Requires an uppercase letter, digit and special character; space is not a special character. No trimming."
          }
        },
        "required": [
          "email",
          "code",
          "newPassword"
        ]
      }
    }
  }
}
