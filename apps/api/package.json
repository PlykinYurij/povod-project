{
  "name": "@povod/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --watch-path=src --require ts-node/register src/main.ts",
    "start": "node dist/main.js",
    "worker:photos": "node dist/photo-worker.js",
    "typecheck": "npm run db:generate && tsc --noEmit -p tsconfig.json && tsc -p tsconfig.tests.json",
    "build": "npm run db:generate && tsc -p tsconfig.build.json",
    "db:generate": "prisma generate --config prisma.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1175.0",
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-express": "11.2.9",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.8.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie": "2.0.2",
    "fflate": "0.8.3",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.15.5",
    "prisma": "7.10.1",
    "ts-node": "10.9.2"
  }
}
