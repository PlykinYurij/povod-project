generator client {
  provider = "prisma-client"
  output = "../src/database/generated"
  moduleFormat = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// Technical evidence only; not a product entity or user data.
model DatabaseProbe {
  id String @id
  label String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("database_probe")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(254)
  userName String? @map("user_name") @db.VarChar(80)
  passwordHash String @map("password_hash")
  role UserRole @default(USER)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  sessions Session[]
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  passwordResets PasswordReset[]
  projects Project[] @relation("ProjectOwner")
  createdProjects Project[] @relation("ProjectCreator")
  serviceRequests ServiceRequest[]

  @@map("users")
}

model Project {
  id String @id @default(uuid()) @db.Uuid
  ownerId String? @map("owner_id") @db.Uuid
  owner User? @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  createdBy User? @relation("ProjectCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  templateVersionId String @map("template_version_id")
  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  title String @db.VarChar(24)
  content Json @db.JsonB
  revision Int @default(1)
  creationKeyHash String @map("creation_key_hash") @db.Char(64)
  creationPayloadHash String @map("creation_payload_hash") @db.Char(64)
  firstPublishedAt DateTime? @map("first_published_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  serviceRequests ServiceRequest[]
  photos ProjectPhoto[]
  publication Publication?

  @@unique([ownerId, creationKeyHash])
  @@index([ownerId, deletedAt, firstPublishedAt])
  @@index([createdByUserId])
  @@map("projects")
}

model Publication {
  id String @id @default(uuid()) @db.Uuid
  projectId String @unique @map("project_id") @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  slug String @unique @db.VarChar(63)
  visible Boolean @default(false)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  snapshots PublicationSnapshot[]
  rsvpRateLimits RsvpRateLimit[]

  @@map("publications")
}

enum RsvpFormSchema {
  garden_v1
}

model PublicationSnapshot {
  id String @id @default(uuid()) @db.Uuid
  publicationId String @map("publication_id") @db.Uuid
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  projectRevision Int @map("project_revision")
  content Json @db.JsonB
  formSchema RsvpFormSchema @map("form_schema")
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  responses RsvpResponse[]

  // SQL enforces one current snapshot per publication.
  @@unique([id, publicationId])
  @@map("publication_snapshots")
}

enum RsvpAttendance {
  yes
  no
}

model RsvpResponse {
  id String @id @default(uuid()) @db.Uuid
  publicationId String @map("publication_id") @db.Uuid
  formVersionId String @map("form_version_id") @db.Uuid
  formVersion PublicationSnapshot @relation(fields: [formVersionId, publicationId], references: [id, publicationId], onDelete: Restrict)
  keyHash String @map("key_hash") @db.Char(64)
  name String @db.VarChar(80)
  attendance RsvpAttendance
  companions Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([publicationId, keyHash])
  @@index([formVersionId, publicationId])
  @@map("rsvp_responses")
}

model RsvpRateLimit {
  publicationId String @map("publication_id") @db.Uuid
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  clientKey String @map("client_key") @db.Char(64)
  count Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([publicationId, clientKey])
  @@index([expiresAt])
  @@map("rsvp_rate_limits")
}

enum ProjectPhotoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model ProjectPhoto {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  status ProjectPhotoStatus @default(UPLOADING)
  uploadKeyHash String @map("upload_key_hash") @db.Char(64)
  sha256 String @db.Char(64)
  mime String @db.VarChar(16)
  byteSize Int @map("byte_size")
  processingAttempts Int @default(0) @map("processing_attempts")
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  leaseToken String? @map("lease_token") @db.Uuid
  renditionToken String? @map("rendition_token") @db.Uuid
  renderWidth Int? @map("render_width")
  renderHeight Int? @map("render_height")
  width Int
  height Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([projectId, uploadKeyHash])
  @@index([status, createdAt])
  @@map("project_photos")
}

model TemplateCategory {
  id String @id @db.VarChar(64)
  titleRu String @map("title_ru") @db.VarChar(80)
  titleEn String @map("title_en") @db.VarChar(80)
  active Boolean @default(true)
  templates Template[]

  @@map("template_categories")
}

model Template {
  id String @id @db.VarChar(64)
  categoryId String @map("category_id") @db.VarChar(64)
  category TemplateCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  titleRu String @map("title_ru") @db.VarChar(80)
  titleEn String @map("title_en") @db.VarChar(80)
  active Boolean @default(true)
  priceMinor Int? @map("price_minor")
  currency String @default("RUB") @db.VarChar(3)
  priceVersion Int @default(1) @map("price_version")
  versions TemplateVersion[]

  @@index([categoryId, active])
  @@map("templates")
}

model TemplateVersion {
  id String @id
  templateId String @map("template_id") @db.VarChar(64)
  template Template @relation(fields: [templateId], references: [id], onDelete: Restrict)
  schemaVersion Int @map("schema_version")
  rendererKey String @map("renderer_key")
  defaultsVersion Int @map("defaults_version")
  availableForNewProjects Boolean @default(false) @map("available_for_new_projects")
  projects Project[]

  @@unique([templateId, schemaVersion])
  // SQL adds a partial unique index: at most one available version per template.
  @@map("template_versions")
}

enum ServiceRequestKind {
  ASSISTANCE
  PUBLICATION
}

enum ContactChannel {
  TELEGRAM
  MAX
  VK
}

enum ServiceRequestStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

model ServiceRequest {
  id String @id @default(uuid()) @db.Uuid
  kind ServiceRequestKind @default(ASSISTANCE)
  projectId String? @map("project_id") @db.Uuid
  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  customerUserId String? @map("customer_user_id") @db.Uuid
  customer User? @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  contactName String @map("contact_name") @db.VarChar(80)
  phone String @db.VarChar(16)
  contactChannel ContactChannel @map("contact_channel")
  contactValue String @map("contact_value") @db.VarChar(200)
  status ServiceRequestStatus @default(NEW)
  requestVersion Int @default(1) @map("request_version")
  submittedRevision Int? @map("submitted_revision")
  priceSnapshotMinor Int? @map("price_snapshot_minor")
  priceSnapshotCurrency String? @map("price_snapshot_currency") @db.VarChar(3)
  priceSnapshotVersion Int? @map("price_snapshot_version")
  creationKeyHash String @unique @map("creation_key_hash") @db.Char(64)
  creationPayloadHash String @map("creation_payload_hash") @db.Char(64)
  consentAt DateTime @map("consent_at") @db.Timestamptz(3)
  consentVersion String @map("consent_version") @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt, id])
  @@index([customerUserId, createdAt])
  // SQL enforces one open request per linked project (NULL is allowed for assistance).
  @@map("service_requests")
}

model ServiceRequestRateLimit {
  key String @id @db.Char(64)
  count Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("service_request_rate_limits")
}

model Session {
  tokenHash String @id @map("token_hash") @db.Char(64)
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginAttempt {
  key String @id @db.Char(64)
  count Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("login_attempts")
}

model PasswordReset {
  emailKey String @id @map("email_key") @db.Char(64)
  id String @unique @db.Uuid
  userId String? @map("user_id") @db.Uuid
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String @map("code_hash") @db.Char(64)
  attempts Int @default(0)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
  usedAt DateTime? @map("used_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("password_resets")
}

model ResetRateLimit {
  key String @id @db.Char(64)
  count Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("reset_rate_limits")
}

model PendingRegistration {
  email String @id @db.VarChar(254)
  userName String? @map("user_name") @db.VarChar(80)
  id String @unique @db.Uuid
  nonce String @db.Uuid
  passwordHash String @map("password_hash")
  codeHash String @map("code_hash") @db.Char(64)
  attempts Int @default(0)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  deleteAt DateTime @map("delete_at") @db.Timestamptz(3)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
  @@index([deleteAt])
  @@map("pending_registrations")
}
